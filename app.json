{
  "expo": {
    "name": "ProyectoFinal",
    "slug": "ProyectoFinal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ProyectoFinal",
      "appleTeamId": "HPG9YDA6W8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-fast-tflite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La cámara se usa solo para tomar la foto del hallazgo. También puedes elegir una foto de tu galería: la app solo recibe esa foto, no accede al resto. Todo se procesa en tu teléfono."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La ubicación se guarda con cada hallazgo para registrar dónde lo encontraste."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ]
  }
}
